# Required: copy to .env and fill GROQ_API_KEY at minimum.
# Never commit a real .env.

# --- required ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- postgres (compose default) ---
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
# Host scripts (ingest) use localhost. Compose overrides this to the postgres hostname for the backend container.
DATABASE_URL=postgresql://lenny:lenny@localhost:5432/lenny

# --- models ---
DEFAULT_MODEL_PROVIDER=groq
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
MODEL_TIMEOUT_SECONDS=60

# --- optional cloud failover ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-70b-instruct

# --- optional BYOK, never the free default ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
